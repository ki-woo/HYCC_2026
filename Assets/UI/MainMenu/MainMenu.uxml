            <ui:Label text="TITLE" name="Title" style="width: 800px; height: 150px; -unity-font-definition: url(&quot;project://database/Assets/UI/Asset/BoldPixels.otf?fileID=12800000&amp;guid=19b9bfe81b147ba4f91b639e7c1b07d9&amp;type=3#BoldPixels&quot;); color: rgb(255, 255, 255); -unity-text-align: lower-center; font-size: 170px;"/>
